-                        if (cd != null) {
-                            context.getString(R.string.mobile_data_text_format, roaming, cd)
+                        if (convertedCd != null) {
+                            context.getString(R.string.mobile_data_text_format, roaming, convertedCd)
                         } else {
                             roaming
                         }
                     } else {
-                        cd
+                        convertedCd
                     }
                 }
             }
@@ -176,6 +182,17 @@ constructor(
             null
         }
 
+    private fun convertLteToFourg(description: String): String {
+        // Convert LTE to 4G in the text
+        if (description.contains("LTE")) {
