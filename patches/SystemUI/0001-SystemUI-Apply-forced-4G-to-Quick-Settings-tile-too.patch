From ea6dc763fceca774a01f5d0b079d14e1470cc7be Mon Sep 17 00:00:00 2001
From: Flopster101 <nahuelgomez329@gmail.com>
Date: Sun, 5 Oct 2025 14:42:00 -0300
Subject: [PATCH] SystemUI: Apply forced 4G to Quick Settings tile too

This way, when crDroid's "4G icon" setting is enabled, it applies
consistently across the UI.

Signed-off-by: Flopster101 <nahuelgomez329@gmail.com>
---
 .../InternetDetailsContentController.java     | 46 +++++++++++++++++--
 .../connectivity/MobileSignalController.java  | 26 ++++++++++-
 .../ui/viewmodel/InternetTileViewModel.kt     | 25 ++++++++--
 3 files changed, 89 insertions(+), 8 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/qs/tiles/dialog/InternetDetailsContentController.java b/packages/SystemUI/src/com/android/systemui/qs/tiles/dialog/InternetDetailsContentController.java
index d07e32a1b..de041f0d9 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/tiles/dialog/InternetDetailsContentController.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/dialog/InternetDetailsContentController.java
@@ -100,6 +100,8 @@ import com.android.systemui.statusbar.policy.KeyguardStateController;
 import com.android.systemui.statusbar.policy.LocationController;
 import com.android.systemui.toast.SystemUIToast;
 import com.android.systemui.toast.ToastFactory;
+import com.android.systemui.tuner.TunerService;
+import com.android.systemui.Dependency;
 import com.android.systemui.util.CarrierConfigTracker;
 import com.android.systemui.util.settings.GlobalSettings;
 import com.android.wifitrackerlib.HotspotNetworkEntry;
@@ -125,7 +127,7 @@ import javax.inject.Inject;
 /**
  * Controller for Internet Dialog.
  */
-public class InternetDetailsContentController implements AccessPointController.AccessPointCallback {
+public class InternetDetailsContentController implements AccessPointController.AccessPointCallback, TunerService.Tunable {
 
     private static final String TAG = "InternetDetailsContentController";
     private static final String ACTION_WIFI_SCANNING_SETTINGS =
@@ -141,6 +143,8 @@ public class InternetDetailsContentController implements AccessPointController.A
     private static final String SETTINGS_EXTRA_SHOW_FRAGMENT_ARGUMENTS =
             ":settings:show_fragment_args";
     private static final String AUTO_DATA_SWITCH_SETTING_R_ID = "auto_data_switch";
+    private static final String SHOW_FOURG_ICON =
+            "system:" + Settings.System.SHOW_FOURG_ICON;
     public static final Drawable EMPTY_DRAWABLE = new ColorDrawable(Color.TRANSPARENT);
     public static final int NO_CELL_DATA_TYPE_ICON = 0;
     private static final int SUBTITLE_TEXT_WIFI_IS_OFF = R.string.wifi_is_off;
@@ -191,6 +195,7 @@ public class InternetDetailsContentController implements AccessPointController.A
     private Handler mHandler;
     private Handler mWorkerHandler;
     private MobileMappings.Config mConfig = null;
+    private boolean mShowFourgIcon = false;
     private Executor mExecutor;
     private AccessPointController mAccessPointController;
     private IntentFilter mConnectionStateFilter;
@@ -352,6 +357,19 @@ public class InternetDetailsContentController implements AccessPointController.A
         mHotspotController = hotspotController;
         mPolicyManager = NetworkPolicyManager.from(context);
         mFeatureFlags = featureFlags;
+        TunerService tunerService = Dependency.get(TunerService.class);
+        tunerService.addTunable(this, SHOW_FOURG_ICON);
+    }
+
+    @Override
+    public void onTuningChanged(String key, String newValue) {
+        switch (key) {
+            case SHOW_FOURG_ICON:
+                mShowFourgIcon = TunerService.parseIntegerSwitch(newValue, false);
+                break;
+            default:
+                break;
+        }
     }
 
     void onStart(@NonNull InternetDialogCallback callback, boolean canConfigWifi) {
@@ -823,8 +841,14 @@ public class InternetDetailsContentController implements AccessPointController.A
             resId = iconGroup.dataContentDescription;
         }
 
-        return resId != 0 ? SubscriptionManager.getResourcesForSubId(context, subId).getString(
-                resId) : "";
+        String description = resId != 0
+                ? SubscriptionManager.getResourcesForSubId(context, subId).getString(resId) : "";
+
+        if (mShowFourgIcon && !description.isEmpty()) {
+            description = convertLteToFourg(description);
+        }
+
+        return description; 
     }
 
     private String getMobileSummary(Context context, String networkTypeDescription, int subId) {
@@ -1689,4 +1713,20 @@ public class InternetDetailsContentController implements AccessPointController.A
         WifiDppIntentHelper.setConfiguratorIntentExtra(intent, mWifiManager, wifiConfiguration);
         return intent;
     }
+
+    private String convertLteToFourg(String description) {
+        if (description == null) {
+            return null;
+        }
+
+        // Convert LTE to 4G in the text
+        if (description.contains("LTE")) {
+            description = description.replace("LTE", "4G");
+        }
+        if (description.contains("LTE+")) {
+            description = description.replace("LTE+", "4G+");
+        }
+
+        return description;
+    }
 }
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/connectivity/MobileSignalController.java b/packages/SystemUI/src/com/android/systemui/statusbar/connectivity/MobileSignalController.java
index 087f9ac29..0f40f65df 100644
