         mShow4GForLTE = bundle.getBoolean(CarrierConfigManager.KEY_SHOW_4G_FOR_LTE_DATA_ICON_BOOL,
                 false);
+        // Also check system setting for 4G icon preference
+        mShow4GForLTE = mShow4GForLTE || Settings.System.getInt(
