@@ -320,6 +321,9 @@ public class EnabledNetworkModePreferenceController extends
                         CarrierConfigManager.KEY_SHOW_CDMA_CHOICES_BOOL);
                 mShow4gForLTE = carrierConfig.getBoolean(
                         CarrierConfigManager.KEY_SHOW_4G_FOR_LTE_DATA_ICON_BOOL);
+                // Also check system setting for 4G icon preference
+                mShow4gForLTE = mShow4gForLTE || Settings.System.getInt(
+                        mContext.getContentResolver(), Settings.System.SHOW_FOURG_ICON, 0) == 1;
                 mDisplay2gOptions = carrierConfig.getBoolean(
                         CarrierConfigManager.KEY_PREFER_2G_BOOL);
 
diff --git a/src/com/android/settings/network/telephony/NetworkSelectSettings.java b/src/com/android/settings/network/telephony/NetworkSelectSettings.java
index 5b2eba2..a49a73b 100644
--- a/src/com/android/settings/network/telephony/NetworkSelectSettings.java
+++ b/src/com/android/settings/network/telephony/NetworkSelectSettings.java
@@ -127,6 +127,9 @@ public class NetworkSelectSettings extends DashboardFragment {
                 CarrierConfigManager.KEY_REMOVE_SATELLITE_PLMN_IN_MANUAL_NETWORK_SCAN_BOOL);
         mShow4GForLTE = bundle.getBoolean(CarrierConfigManager.KEY_SHOW_4G_FOR_LTE_DATA_ICON_BOOL,
                 false);
+        // Also check system setting for 4G icon preference
+        mShow4GForLTE = mShow4GForLTE || Settings.System.getInt(
+                context.getContentResolver(), Settings.System.SHOW_FOURG_ICON, 0) == 1;
         mShouldFilterOutSatellitePlmn.set(bundle.getBoolean(
                 CarrierConfigManager.KEY_REMOVE_SATELLITE_PLMN_IN_MANUAL_NETWORK_SCAN_BOOL,
                 true));
