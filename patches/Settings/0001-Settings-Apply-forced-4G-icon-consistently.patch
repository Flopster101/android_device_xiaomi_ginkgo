From cce0330e65a188ddcea057511e03e51bc0813a23 Mon Sep 17 00:00:00 2001
From: Flopster101 <nahuelgomez329@gmail.com>
Date: Tue, 30 Sep 2025 00:57:53 -0300
Subject: [PATCH] Settings: Apply forced 4G icon consistently

This way, when crDroid's "4G icon" setting is enabled, it applies
consistently across the menus.

Signed-off-by: Flopster101 <nahuelgomez329@gmail.com>
---
 .../simstatus/SimStatusDialogController.java  |  3 ++
 .../settings/network/MobileIconGroupExt.kt    | 30 ++++++++++++++++++-
 ...nabledNetworkModePreferenceController.java |  4 +++
 .../telephony/NetworkSelectSettings.java      |  3 ++
 4 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/src/com/android/settings/deviceinfo/simstatus/SimStatusDialogController.java b/src/com/android/settings/deviceinfo/simstatus/SimStatusDialogController.java
index f86f7ae..1b804fe 100644
--- a/src/com/android/settings/deviceinfo/simstatus/SimStatusDialogController.java
+++ b/src/com/android/settings/deviceinfo/simstatus/SimStatusDialogController.java
@@ -485,6 +485,9 @@ public class SimStatusDialogController implements DefaultLifecycleObserver {
             show4GForLTE = carrierConfig.getBoolean(
                     CarrierConfigManager.KEY_SHOW_4G_FOR_LTE_DATA_ICON_BOOL);
         }
+        // Also check system setting for 4G icon preference
+        show4GForLTE = show4GForLTE || android.provider.Settings.System.getInt(
+                mContext.getContentResolver(), android.provider.Settings.System.SHOW_FOURG_ICON, 0) == 1;
 
         if (show4GForLTE) {
             if ("LTE".equals(dataNetworkTypeName)) {
diff --git a/src/com/android/settings/network/MobileIconGroupExt.kt b/src/com/android/settings/network/MobileIconGroupExt.kt
index 0435ef0..ae157a6 100644
--- a/src/com/android/settings/network/MobileIconGroupExt.kt
+++ b/src/com/android/settings/network/MobileIconGroupExt.kt
@@ -17,6 +17,7 @@
 package com.android.settings.network
 
 import android.content.Context
+import android.provider.Settings
 import android.telephony.SubscriptionManager
 import android.text.Html
 import com.android.settingslib.SignalIcon
@@ -25,8 +26,18 @@ fun SignalIcon.MobileIconGroup.getSummaryForSub(context: Context, subId: Int): S
     when (dataContentDescription) {
         0 -> ""
         else -> {
-            SubscriptionManager.getResourcesForSubId(context, subId)
+            var description = SubscriptionManager.getResourcesForSubId(context, subId)
                 .getString(dataContentDescription)
+
+            // Check system setting for 4G icon preference
+            val showFourgIcon = Settings.System.getInt(
+                context.contentResolver, Settings.System.SHOW_FOURG_ICON, 0) == 1
+
+            if (showFourgIcon) {
+                description = convertLteToFourg(description)
+            }
+
+            description
         }
     }
 
@@ -35,4 +46,21 @@ fun String.maybeToHtml(): CharSequence = when {
     else -> this
 }
 
+private fun convertLteToFourg(description: String): String {
+    if (description.isEmpty()) {
+        return description
+    }
+
+    // Convert LTE to 4G in the text
+    var result = description
+    if (result.contains("LTE")) {
+        result = result.replace("LTE", "4G")
+    }
+    if (result.contains("LTE+")) {
+        result = result.replace("LTE+", "4G+")
+    }
+
+    return result
+}
+
 private const val HTML_TAG = "</"
diff --git a/src/com/android/settings/network/telephony/EnabledNetworkModePreferenceController.java b/src/com/android/settings/network/telephony/EnabledNetworkModePreferenceController.java
