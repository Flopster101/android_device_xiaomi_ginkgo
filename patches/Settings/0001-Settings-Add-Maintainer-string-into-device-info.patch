From 56cb489cc5b66ed21888b13c82a4a2a900bb5c20 Mon Sep 17 00:00:00 2001
From: LuK1337 <priv.luk@gmail.com>
Date: Sat, 27 Sep 2025 17:46:03 -0300
Subject: [PATCH] Settings: Add Maintainer string into device info

Change-Id: I4acf834442712954f8e9db15370bffafd4547174
Signed-off-by: Ksawlii <ksawery.blaszczak@proton.me>
Signed-off-by: mytja <mytja@proton.me>
[Flopster101: Made more generic.]
Signed-off-by: Flopster101 <nahuelgomez329@gmail.com>
---
 res/values/cm_strings.xml                     |  4 ++
 res/xml/firmware_version.xml                  |  8 ++++
 .../BuildMaintainerPreferenceController.java  | 43 +++++++++++++++++++
 3 files changed, 55 insertions(+)
 create mode 100644 src/com/android/settings/deviceinfo/firmwareversion/BuildMaintainerPreferenceController.java

diff --git a/res/values/cm_strings.xml b/res/values/cm_strings.xml
index b3e7df2a079..93f9db1f45b 100644
--- a/res/values/cm_strings.xml
+++ b/res/values/cm_strings.xml
@@ -197,4 +197,8 @@
     <string name="battery_maximum_capacity">Maximum capacity</string>
     <string name="battery_maximum_capacity_summary">%1$d mAh (%2$d%%)</string>
     <string name="battery_maximum_capacity_not_available" translatable="false">@string/battery_cycle_count_not_available</string>
+
+    <!-- Android version screen, build maintainer -->
+    <string name="build_maintainer">Maintainer</string>
+    <string name="build_maintainer_summary" translatable="false">UNKNOWN</string>
 </resources>
diff --git a/res/xml/firmware_version.xml b/res/xml/firmware_version.xml
index bd3294b2f47..575474e1f9c 100644
--- a/res/xml/firmware_version.xml
+++ b/res/xml/firmware_version.xml
@@ -44,6 +44,14 @@
         settings:searchable="false"
         settings:controller="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionDetailPreferenceController"/>
 
+    <!-- Maintainer -->
+    <Preference
+        android:key="os_build_maintainer"
+        android:title="@string/build_maintainer"
+        android:summary="@string/summary_placeholder"
+        settings:enableCopying="true"
+        settings:controller="com.android.settings.deviceinfo.firmwareversion.BuildMaintainerPreferenceController"/>
+
     <!-- Lineage version -->
     <Preference
         android:key="lineage_version"
diff --git a/src/com/android/settings/deviceinfo/firmwareversion/BuildMaintainerPreferenceController.java b/src/com/android/settings/deviceinfo/firmwareversion/BuildMaintainerPreferenceController.java
new file mode 100644
index 00000000000..a0e599c9b57
--- /dev/null
+++ b/src/com/android/settings/deviceinfo/firmwareversion/BuildMaintainerPreferenceController.java
@@ -0,0 +1,43 @@
+/*
+ * Copyright (C) 2024 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.deviceinfo.firmwareversion;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.res.Resources;
+import android.net.Uri;
+import android.text.TextUtils;
+import android.util.Log;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+public class BuildMaintainerPreferenceController extends BasePreferenceController {
+
+    private static final String TAG = "BuildMaintainerCtrl";
+
+    private String mDeviceMaintainer;
+
+    public BuildMaintainerPreferenceController(Context context, String key) {
+        super(context, key);
+        mDeviceMaintainer = mContext.getResources().getString(R.string.build_maintainer_summary);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        if (mDeviceMaintainer.equalsIgnoreCase("UNKNOWN")) {
+            return UNSUPPORTED_ON_DEVICE;
+        }
+        return AVAILABLE;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        return mDeviceMaintainer;
+    }
+}
-- 
