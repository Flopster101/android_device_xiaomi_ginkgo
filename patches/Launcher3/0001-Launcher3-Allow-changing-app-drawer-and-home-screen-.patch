From ace8c1f752ed53f7cbd67edf44999eb48a573850 Mon Sep 17 00:00:00 2001
From: Flopster101 <nahuelgomez329@gmail.com>
Date: Sun, 5 Oct 2025 14:28:22 -0300
Subject: [PATCH] Launcher3: Allow changing app drawer and home screen grid
 size from settings

Version 2

Signed-off-by: Flopster101 <nahuelgomez329@gmail.com>
---
 res/values/cr_strings.xml                     | 38 +++++++++++++++++++
 res/xml/launcher_app_drawer_preferences.xml   | 10 +++++
 res/xml/launcher_home_screen_preferences.xml  | 10 +++++
 .../launcher3/InvariantDeviceProfile.java     | 28 ++++++++++++++
 src/com/android/launcher3/LauncherPrefs.kt    |  2 +
 src/com/android/launcher3/Utilities.java      |  8 ++++
 .../launcher3/settings/SettingsAppDrawer.java |  3 +-
 .../settings/SettingsHomescreen.java          |  3 +-
 8 files changed, 100 insertions(+), 2 deletions(-)

diff --git a/res/values/cr_strings.xml b/res/values/cr_strings.xml
index 103fd5e32f..506c0c31d0 100644
--- a/res/values/cr_strings.xml
+++ b/res/values/cr_strings.xml
@@ -412,4 +412,42 @@
     <!-- Auto-hide page indicator dots -->
     <string name="auto_hide_dots">Auto-hide page indicator</string>
     <string name="auto_hide_dots_summary">Hide the page indicator dots automatically</string>
+
+    <!-- Grid size settings -->
+    <string name="homescreen_grid_size_title">Home screen grid size</string>
+    <string name="homescreen_grid_size_summary">Number of icons per row on homescreen</string>
+    <string name="app_drawer_grid_size_title">App drawer grid size</string>
+    <string name="app_drawer_grid_size_summary">Number of icons per row in app drawer</string>
+    <string name="grid_size_3x3">3x3</string>
+    <string name="grid_size_4x4">4x4</string>
+    <string name="grid_size_4x5">4x5</string>
+    <string name="grid_size_5x5">5x5</string>
+    <string name="grid_size_5x6">5x6</string>
+    <string name="grid_size_6x5">6x5</string>
+    <string name="grid_size_6x6">6x6</string>
+    <string name="grid_size_auto">Auto (device default)</string>
+
+    <!-- Grid size arrays -->
+    <string-array name="grid_size_entries">
+        <item>Auto (device default)</item>
+        <item>3x3</item>
+        <item>4x4</item>
+        <item>4x5</item>
+        <item>5x5</item>
+        <item>5x6</item>
+        <item>6x5</item>
+        <item>6x6</item>
+    </string-array>
+
+    <string-array name="grid_size_values">
+        <item>auto</item>
+        <item>3x3</item>
+        <item>4x4</item>
+        <item>4x5</item>
+        <item>5x5</item>
+        <item>5x6</item>
+        <item>6x5</item>
+        <item>6x6</item>
+    </string-array>
+
 </resources>
diff --git a/res/xml/launcher_app_drawer_preferences.xml b/res/xml/launcher_app_drawer_preferences.xml
index 705dd0db33..407853d7f2 100644
--- a/res/xml/launcher_app_drawer_preferences.xml
+++ b/res/xml/launcher_app_drawer_preferences.xml
@@ -65,4 +65,14 @@
         settings:units="%"
         android:defaultValue="100" />
 
+    <ListPreference
+        android:key="pref_app_drawer_grid_size"
+        android:title="@string/app_drawer_grid_size_title"
+        android:summary="@string/app_drawer_grid_size_summary"
+        android:persistent="true"
+        android:entries="@array/grid_size_entries"
+        android:entryValues="@array/grid_size_values"
+        android:defaultValue="auto"
+        launcher:iconSpaceReserved="false" />
+
 </androidx.preference.PreferenceScreen>
diff --git a/res/xml/launcher_home_screen_preferences.xml b/res/xml/launcher_home_screen_preferences.xml
index c4554ffa09..1aebed48cb 100644
--- a/res/xml/launcher_home_screen_preferences.xml
+++ b/res/xml/launcher_home_screen_preferences.xml
@@ -31,6 +31,16 @@
             android:summaryOff="@string/settings_lock_layout_summary_off"
             launcher:iconSpaceReserved="false" />
 
+        <ListPreference
+            android:key="pref_homescreen_grid_size"
+            android:title="@string/homescreen_grid_size_title"
+            android:summary="@string/homescreen_grid_size_summary"
+            android:persistent="true"
+            android:entries="@array/grid_size_entries"
+            android:entryValues="@array/grid_size_values"
+            android:defaultValue="auto"
+            launcher:iconSpaceReserved="false" />
+
         <SwitchPreferenceCompat
             android:key="pref_add_icon_to_home"
             android:title="@string/auto_add_shortcuts_label"
diff --git a/src/com/android/launcher3/InvariantDeviceProfile.java b/src/com/android/launcher3/InvariantDeviceProfile.java
index 508f26b2d4..f267a86ad7 100644
--- a/src/com/android/launcher3/InvariantDeviceProfile.java
+++ b/src/com/android/launcher3/InvariantDeviceProfile.java
@@ -448,6 +448,9 @@ public class InvariantDeviceProfile {
         numDatabaseAllAppsColumns = deviceType == TYPE_MULTI_DISPLAY
                 ? closestProfile.numDatabaseAllAppsColumns : closestProfile.numAllAppsColumns;
 
+        // Apply custom app drawer grid size if set
+        applyCustomAppDrawerGridSize(context);
+
         allAppsCellSize = displayOption.allAppsCellSize;
         allAppsBorderSpaces = displayOption.allAppsBorderSpaces;
         allAppsIconSize = displayOption.allAppsIconSizes;
@@ -521,6 +524,14 @@ public class InvariantDeviceProfile {
         mChangeListeners.remove(listener);
     }
 
+    public static String getCurrentGridName(Context context) {
+        String customGridSize = Utilities.getHomescreenGridSize(context);
+        if (!"auto".equals(customGridSize)) {
+            return customGridSize;
+        }
+        return LauncherPrefs.get(context).get(GRID_NAME);
+    }
+
     /**
      * Updates the current grid, this triggers a new IDP, reloads the database and triggers a grid
      * migration.
@@ -1593,4 +1604,21 @@ public class InvariantDeviceProfile {
             return this;
         }
     }
+
+    private void applyCustomAppDrawerGridSize(Context context) {
+        String customGridSize = Utilities.getAppDrawerGridSize(context);
+        if (!"auto".equals(customGridSize)) {
+            try {
+                // Parse grid size (e.g., "4x4" -> 4 columns)
+                String[] parts = customGridSize.split("x");
+                if (parts.length >= 1) {
+                    int columns = Integer.parseInt(parts[0]);
+                    numAllAppsColumns = columns;
+                    numDatabaseAllAppsColumns = columns;
+                }
+            } catch (NumberFormatException e) {
+                // Invalid format, keep default
+            }
+        }
+    }
 }
diff --git a/src/com/android/launcher3/LauncherPrefs.kt b/src/com/android/launcher3/LauncherPrefs.kt
index 4fd288f74e..b363289bdd 100644
--- a/src/com/android/launcher3/LauncherPrefs.kt
+++ b/src/com/android/launcher3/LauncherPrefs.kt
@@ -286,6 +286,8 @@ constructor(@ApplicationContext private val encryptedContext: Context) {
         @JvmField val WORK_EDU_STEP = backedUpItem("showed_work_profile_edu", 0)
         @JvmField val SLEEP_GESTURE = backedUpItem("pref_sleep_gesture", true)
         @JvmField val SLEEP_GESTURE_HAPTIC = backedUpItem("pref_sleep_gesture_haptic", true)
+        @JvmField val HOMESCREEN_GRID_SIZE = backedUpItem("pref_homescreen_grid_size", "auto")
+        @JvmField val APP_DRAWER_GRID_SIZE = backedUpItem("pref_app_drawer_grid_size", "auto")
         @JvmField
         val WORKSPACE_SIZE =
             backedUpItem(DeviceGridState.KEY_WORKSPACE_SIZE, "", EncryptionType.ENCRYPTED)
diff --git a/src/com/android/launcher3/Utilities.java b/src/com/android/launcher3/Utilities.java
index d48ac7bb13..3b0b479179 100644
--- a/src/com/android/launcher3/Utilities.java
+++ b/src/com/android/launcher3/Utilities.java
@@ -1129,4 +1129,12 @@ public final class Utilities {
     public static void startLmoFreeform(Context context, ComponentName activity) {
         startLmoFreeform(context, activity, UserHandle.myUserId());
     }
+
+    public static String getHomescreenGridSize(Context context) {
+        return LauncherPrefs.HOMESCREEN_GRID_SIZE.get(context);
+    }
+
+    public static String getAppDrawerGridSize(Context context) {
+        return LauncherPrefs.APP_DRAWER_GRID_SIZE.get(context);
+    }
 }
diff --git a/src/com/android/launcher3/settings/SettingsAppDrawer.java b/src/com/android/launcher3/settings/SettingsAppDrawer.java
index 72cda6a2d2..cf5f4bade8 100644
--- a/src/com/android/launcher3/settings/SettingsAppDrawer.java
+++ b/src/com/android/launcher3/settings/SettingsAppDrawer.java
@@ -114,7 +114,8 @@ public class SettingsAppDrawer extends CollapsingToolbarBaseActivity
     @Override
     public void onSharedPreferenceChanged(SharedPreferences sharedPreferences, String key) {
         if (LauncherPrefs.DRAWER_SEARCH.getSharedPrefKey().equals(key) ||
-                LauncherPrefs.DRAWER_SCROLLBAR.getSharedPrefKey().equals(key)) {
+                LauncherPrefs.DRAWER_SCROLLBAR.getSharedPrefKey().equals(key) ||
+                LauncherPrefs.APP_DRAWER_GRID_SIZE.getSharedPrefKey().equals(key)) {
             LauncherAppState.INSTANCE.executeIfCreated(app -> app.setNeedsRestart());
         }
     }
diff --git a/src/com/android/launcher3/settings/SettingsHomescreen.java b/src/com/android/launcher3/settings/SettingsHomescreen.java
index 1050ade3fd..988c1c10d2 100644
--- a/src/com/android/launcher3/settings/SettingsHomescreen.java
+++ b/src/com/android/launcher3/settings/SettingsHomescreen.java
@@ -131,7 +131,8 @@ public class SettingsHomescreen extends CollapsingToolbarBaseActivity
                 LauncherPrefs.SHOW_QUICKSPACE_WEATHER_CITY.getSharedPrefKey().equals(key) ||
                 LauncherPrefs.SHOW_QUICKSPACE_WEATHER_PROVIDER.getSharedPrefKey().equals(key) ||
                 LauncherPrefs.SHOW_QUICKSPACE_WEATHER_TEXT.getSharedPrefKey().equals(key) ||
-                LauncherPrefs.AUTO_HIDE_DOTS.getSharedPrefKey().equals(key)) {
+                LauncherPrefs.AUTO_HIDE_DOTS.getSharedPrefKey().equals(key) ||
+                LauncherPrefs.HOMESCREEN_GRID_SIZE.getSharedPrefKey().equals(key)) {
             LauncherAppState.INSTANCE.executeIfCreated(app -> app.setNeedsRestart());
         }
     }
